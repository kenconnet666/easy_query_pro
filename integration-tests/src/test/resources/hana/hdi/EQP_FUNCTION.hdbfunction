FUNCTION "EQP_FUNCTION" (
    IN P_NAME NVARCHAR(255) DEFAULT 'other',
    IN P_MIN_ID INTEGER DEFAULT 0,
    IN P_MIN_AMOUNT DECIMAL(19,4) DEFAULT 0
)
RETURNS TABLE (
    "ID" INTEGER,
    "NAME" NVARCHAR(255),
    "AMOUNT" DECIMAL(19,4)
)
LANGUAGE SQLSCRIPT
SQL SECURITY INVOKER
AS
BEGIN
    RETURN
        SELECT "ID", "NAME", "AMOUNT"
        FROM "EQP_SOURCE"
        WHERE (:P_NAME IS NULL OR "NAME" = :P_NAME)
          AND "ID" >= :P_MIN_ID
          AND "AMOUNT" >= :P_MIN_AMOUNT;
END;
